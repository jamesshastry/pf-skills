# ─── Real data. Never committed. ───────────────────────────────────
# Only examples, documentation, and deny-all category scaffolds ship.
# Everything else in inputs/ is yours.
inputs/*
!inputs/*.example.yml
!inputs/README.md
# Committed category scaffolds. Each directory has its own deny-all
# .gitignore, so the folder exists without exposing the documents put in it.
!inputs/banking/
!inputs/business/
!inputs/cross-border/
!inputs/debts/
!inputs/education/
!inputs/estate/
!inputs/healthcare/
!inputs/income/
!inputs/insurance/
!inputs/investments/
!inputs/life-events/
!inputs/property/
!inputs/retirement/
!inputs/tax/

# Generated reports. The category scaffolds ship; generated contents never do.
outputs/*
!outputs/.gitkeep
!outputs/README.md
!outputs/history/
!outputs/reports/
!outputs/scenarios/
!outputs/structured/

# Immutable snapshots contain prior copies of the same private facts.
history/*
!history/.gitkeep

# Your statements, policies and returns. The folder and its README ship;
# nothing you put in it ever does. Note this ignores every extension, not a
# list of them -- a list is a promise to remember the next format.
documents/*
!documents/README.md

# A personal deny-list of your own name/address/policy numbers, for
# local secret scanning. MUST stay local — committing it would publish
# exactly the strings it exists to protect.
.gitleaks.local.toml

# A local list of your own values for scripts/privacy_audit.py. Same reason:
# committing it would publish exactly the strings it exists to protect.
.privacy-tokens.local

# ─── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# ─── OS / editor ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~

# Task briefs dropped into the repo root. They routinely quote real figures
# from the household they were written about -- that is what makes them
# useful -- and this is a public repository.
/*-prompt.md
/*-brief.md
prompts/*-prompt.md
prompts/*-brief.md
